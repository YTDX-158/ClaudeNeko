{
  "name": "claudeneko",
  "version": "2.4.8",
  "private": true,
  "type": "module",
  "description": "ClaudeNeko：在浏览器中驱动 Claude Code CLI 的本地智能对话界面——双吉祥物互动、深度可定制皮肤、实时余额查询",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test",
    "prod": "npm run build && node server/server.js",
    "regression": "node scripts/regression.js",
    "regression:fast": "node scripts/regression.js --skip-chat"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jimp": "^1.6.1",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
