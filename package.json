{
  "name": "claudeneko",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地 Claude Web 界面：在浏览器里驱动 Claude Code CLI（DeepSeek V4 Flash/Pro）",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "prod": "npm run build && node server/server.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
